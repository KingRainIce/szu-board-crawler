<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>lychee.szu-board-crawler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/absolute/path/to/tools/szu-board-crawler/run_once_macos.sh</string>
    <string>/absolute/path/to/tools/szu-board-crawler/config.yaml</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/lychee-szu-board-crawler.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lychee-szu-board-crawler.err.log</string>
</dict>
</plist>
